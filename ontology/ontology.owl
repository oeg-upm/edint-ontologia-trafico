    <!-- http://qudt.org/schema/qudt/LatexString -->

    <rdfs:Datatype rdf:about="http://qudt.org/schema/qudt/LatexString"/>
    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML -->

    <rdfs:Datatype rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYearMonth -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/schema/qudt/hasUnit -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/hasUnit">
        <owl:inverseOf rdf:resource="http://qudt.org/schema/qudt/unitFor"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:ObjectProperty>
    


    <!-- http://qudt.org/schema/qudt/unitFor -->

    <owl:ObjectProperty rdf:about="http://qudt.org/schema/qudt/unitFor"/>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">A spatial representation for a given feature.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una representación espacial para una característica determinada.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0"/>
        <rdfs:label xml:lang="en">has geometry</rdfs:label>
        <rdfs:label xml:lang="es">tiene geometría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/2004/02/skos/core"/>
        <rdfs:label xml:lang="es">está en el esquema</rdfs:label>
        <rdfs:label xml:lang="en">is in scheme</rdfs:label>
        <skos:definition xml:lang="en">Relaciona un recurso (por ejemplo un concepto) con un esquema de conceptos en el que está incluido.</skos:definition>
        <skos:definition xml:lang="en">Relates a resource (for example a concept) to a concept scheme in which it is included.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasBeginning -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasBeginning">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">Beginning of a temporal entity</rdfs:comment>
        <rdfs:comment xml:lang="es">Comienzo de una entidad temporal.</rdfs:comment>
        <rdfs:label xml:lang="en">Has Beginning</rdfs:label>
        <rdfs:label xml:lang="es">Tiene principio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2006/time#hasEnd -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2006/time#hasEnd">
        <rdfs:domain rdf:resource="http://www.w3.org/2006/time#ProperInterval"/>
        <rdfs:range rdf:resource="http://www.w3.org/2006/time#Instant"/>
        <rdfs:comment xml:lang="en">End of a temporal entity</rdfs:comment>
        <rdfs:comment xml:lang="es">Final de una entidad temporal.</rdfs:comment>
        <rdfs:label xml:lang="en">Has End</rdfs:label>
        <rdfs:label xml:lang="es">Tiene final</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/forProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/forProperty"/>
    


    <!-- http://www.w3.org/ns/sosa/hasFeatureOfInterest -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasFeatureOfInterest">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/FeatureOfInterest"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="en">A relation between an Observation and the entity whose quality was observed, or between an Actuation and the entity whose property was modified, or between an act of Sampling and the entity that was sampled.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">has feature of interest</rdfs:label>
        <skos:example xml:lang="en">For example, in an Observation of the weight of a person, the FeatureOfInterest is the person and the property is its weight.</skos:example>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasResult -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hasResult">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isResultOf"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Result"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sample"/>
        <rdfs:comment xml:lang="es">Relación que vincula una observación, una actuación o un acto de muestreo con un resultado o una muestra.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relation linking an Observation or Actuation or act of Sampling and a Result or Sample.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">has result</rdfs:label>
        <rdfs:label xml:lang="es">tiene resultado</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/hosts -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/hosts">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/isHostedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isFeatureOfInterestOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
    


    <!-- http://www.w3.org/ns/sosa/isHostedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isHostedBy">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuator"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampler"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Platform"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor, Actuator, Sampler, or Platform, and the Platform that it is mounted on or hosted by.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">is hosted by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isObservedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isObservedBy">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/observes"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/isResultOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/isResultOf"/>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/madeBySystem"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:comment xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">made by sensor</rdfs:label>
        <rdfs:label xml:lang="en">made by sensor or observer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySystem -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySystem"/>
    


    <!-- http://www.w3.org/ns/sosa/madeObservation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeObservation"/>
    


    <!-- http://www.w3.org/ns/sosa/observedProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observedProperty">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/wasObservedBy"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment xml:lang="en">Relation linking an Observation to the property that was observed. The ObservableProperty should be a property of the FeatureOfInterest (linked by hasFeatureOfInterest) of this Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">observed property</rdfs:label>
        <skos:note xml:lang="en">
  &apos;observed property&apos; covers the concepts referred to in [VIM] as &apos;measurand&apos; (quantitative values) and &apos;examinand&apos; (categorical and nominal values — [VIM4]), as well as complex and structured properties whose values may be represented as lists, vectors, arrays, rasters, geometries, etc. More specific terms are used in other contexts for related concepts, such as &apos;analyte&apos; (chemistry) and &apos;determinand&apos; (water quality).
  </skos:note>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/observes -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/observes">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/sosa/forProperty"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservableProperty"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an ObservableProperty that it is capable of sensing.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">observes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/phenomenonTime -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/phenomenonTime">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/2006/time#TemporalEntity"/>
        <rdfs:comment xml:lang="en">The time that the Result of an Observation, Actuation or Sampling applies to the FeatureOfInterest. Not necessarily the same as the resultTime. May be an Interval or an Instant, or some other compound TemporalEntity.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/common/"/>
        <rdfs:label xml:lang="en">phenomenon time</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/wasObservedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/wasObservedBy">
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Property"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/ObservationCollection"/>
        <rdfs:comment xml:lang="en">relation from a Property to an Observation that observed it</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/obs/"/>
        <rdfs:label xml:lang="en">was observed by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#containsStreetSection -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#containsStreetSection">
        <rdfs:domain rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#Via"/>
        <rdfs:range rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:comment xml:lang="en">A street can contain one or more street sections.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una calle puede contener uno o más tramos de calle.</rdfs:comment>
        <rdfs:label xml:lang="en">contains street section</rdfs:label>
        <rdfs:label xml:lang="es">contiene tramo de vía</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#endOfSection -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#endOfSection">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/sf#Point"/>
        <rdfs:comment xml:lang="es">Relación del tramo con el lugar donde finaliza el tramo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship of the section with the point where it ends.</rdfs:comment>
        <rdfs:label xml:lang="en">end of section</rdfs:label>
        <rdfs:label xml:lang="es">fin del Tramo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#incidentInSection -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#incidentInSection">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#Incident"/>
        <rdfs:range rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:comment xml:lang="es">Relación de la Incidencia con el Tramo donde se produce la misma.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship of the Incident withe the  Section, where it happens.</rdfs:comment>
        <rdfs:label xml:lang="es">incidencia en tramo</rdfs:label>
        <rdfs:label xml:lang="en">incident in Section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#incidentType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#incidentType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#Incident"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/IncidentType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de incidencia, pueden ser planificadas o no planificadas.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of incident, planned or unplannedt</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de Incidencia</rdfs:label>
        <rdfs:label xml:lang="en">type of Incident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#monitors -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#monitors">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#TrafficEquipment"/>
        <rdfs:range rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:comment xml:lang="es">Relación entre el dispositivo de medición de tráfico y el tramo de calle que monitoriza.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between traffic equipment and the street section it monitors.</rdfs:comment>
        <rdfs:label xml:lang="es">monitorea</rdfs:label>
        <rdfs:label xml:lang="en">monitors</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#startOfSection -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#startOfSection">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#StreetSection"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/sf#Point"/>
        <rdfs:comment xml:lang="es">Relación del tramo con el lugar donde se inicia el tramo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship of the section with the point where it starts.</rdfs:comment>
        <rdfs:label xml:lang="es">inicio del Tramo</rdfs:label>
        <rdfs:label xml:lang="en">start of section</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/trafico#trafficEquipmentType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/trafico#trafficEquipmentType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/trafico#TrafficEquipment"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#Concept"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                        <owl:hasValue rdf:resource="https://edint.es/kos/TrafficEquipmentType"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de equipo de tráfico, equipos de control y dispositivos de medición</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of traffic equipment, monitor equipment or meassuring devices</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de Equipo de Tráfico</rdfs:label>
        <rdfs:label xml:lang="en">type of Traffic Equipment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
