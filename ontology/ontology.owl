<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/trafico#"
     xml:base="https://edint.es/def/trafico"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:sf="http://www.opengis.net/ont/sf#"
     xmlns:geo="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:qudt="http://qudt.org/schema/qudt/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:sosa="http://w3.org/ns/sosa/"
     xmlns:time="http://www.w3.org/2006/time#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:escjr="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#"
     xmlns:schema="http://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:geocore="https://datos.ign.es/def/geo_core#"
     xmlns:edintkos="https://edint.es/kos/"
     xmlns:edinttraf="http://vocab.ciudadesabiertas.es/def/transporte/trafico#"
     xmlns:geosparql="http://www.opengis.net/ont/geosparql#">
    <owl:Ontology rdf:about="https://edint.es/def/trafico">
        <owl:versionIRI rdf:resource="https://edint.es/def/trafico"/>
        <dcterms:created>2026-05-11</dcterms:created>
        <dcterms:creator>Daniel Doña</dcterms:creator>
        <dcterms:creator>Edna Ruckhaus</dcterms:creator>
        <dcterms:creator>Lucía Sánchez</dcterms:creator>
        <dcterms:creator>Socorro Bernardos</dcterms:creator>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-11</dcterms:issued>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="es">Vocabulario para la representación de datos sobre el tráfico de vehículos en las ciudades</dcterms:title>
        <dcterms:title xml:lang="en">Vocabulary for the representation of data on vehicle traffic in cities</dcterms:title>
        <vann:preferredNamespacePrefix>edinttraf</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri rdf:resource="https://edint.es/def/trafico#"/>
        <rdfs:comment xml:lang="es">La ontología de Tráfico representa los datos de medición del tráfico de vehículos de una ciudad así como las incidencias planificadas y no planificadas que pueden ocurrir. Incluye también las observaciones de control de velocidad y acceso de vehículo específicos.</rdfs:comment>
        <rdfs:comment xml:lang="en">The Traffic ontology represents the vehicle traffic measurement data for a city, as well as planned and unplanned incidents that may occur. It also includes observations of specific vehicle speed and access controls.</rdfs:comment>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-trafico/releases/tag/v0.1.0"/>
        <owl:versionInfo>0.1.1</owl:versionInfo>
    </owl:Ontology>
    


