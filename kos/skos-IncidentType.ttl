@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <https://edint.es/kos/> .
@prefix edintincidenttype: <https://edint.es/kos/IncidentType/> .

edintincidenttype:traffic-interruption
  skos:broader edintincidenttype:planned-incident ;
  skos:prefLabel "traffic-interruption"@en, "corte-trafico"@es ;
  skos:definition "Incidencia de corta duración que requiere el corte particular de la vía.  Por ejemplo: montaje de grúa; circulación de transportes especiales."@es, "Short-term incident that requires the particular cut of the road. For example: crane assembly; special transport circulation."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:road-occupation
  skos:broader edintincidenttype:planned-incident ;
  skos:prefLabel "Road occupation"@en, "Ocupación vía"@es ;
  skos:definition "Ocupación de la vía pública"@es, "Public road occupation."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:event
  skos:broader edintincidenttype:planned-incident ;
  skos:prefLabel "Event"@en, "Evento"@es ;
  skos:definition "Suceso importante y programado de índole social; académico; artístico; deportivo. Ejemplo: procesiones; cabalgatas."@es, "Important and programmed event of a social; academic; artistic; sporting nature. Example: processions; kings parade."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:road-work
  skos:broader edintincidenttype:planned-incident ;
  skos:prefLabel "Road works"@en, "Obras"@es ;
  skos:definition "Obras en la vía pública."@es, "Works on public roads."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:accident
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "accident"@en, "accidente"@es ;
  skos:definition "Evento en el que uno o más vehículos pierden el control y no se recuperan. Incluye colisiones entre vehículos u otros usuarios de la carretera; entre vehículos y cualquier obstáculo o son el resultado de un vehículo que se sale de la carretera."@es, "Event in which one or more vehicles lose control and do not recover. It includes collisions between vehicles or other road users; between vehicles and any obstacles; or are the result of a vehicle going off the road."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:alert
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "alert"@en, "alerta"@es ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .


edintincidenttype:climate-impact
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "Climate impact"@en, "Climatológica"@es ;
  skos:definition "Incidencia ocasionada por el clima y que conlleva al corte de la vía. Por ejemplo: inundación de paseo marítimo; lluvias excesivas; viento."@es, "Incident caused by the weather and that leads to the cutting of the road. For example: flooding of the promenade; rain; wind."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:traffic-jam
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "Traffic jam"@en, "Congestión de tráfico"@es ;
  skos:definition "Incidencia ocasionada cuando el nivel de servicio del tráfico es de tipo -Congestión-.'"@es, "Incident caused when the level of traffic service is -Congestion-."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:pollution
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "Pollution"@en, "Contaminación"@es ;
  skos:definition "Incidencia por episodio de contaminación."@es, "Incident by pollution episode."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintincidenttype:urgent-road-work
  skos:broader edintincidenttype:unplanned-incident ;
  skos:prefLabel "Urgent works"@en, "Obras de urgencia"@es ;
  skos:definition "Obras que requieren una acción de reparación urgente. Por ejemplo: rotura de tuberías; hundimiento de calzada."@es, "Works that require urgent repair action. For example: broken pipes; sinking of the road."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType .

edintkos:IncidentType
  skos:hasTopConcept edintincidenttype:planned-incident, edintincidenttype:unplanned-incident ;
  skos:prefLabel "Tipo de Incidencia"@es ;
  skos:prefLabel "Incident type"@en ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
  rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  dct:title "Tesauro que recoge los tipos de incidencia; es decir los hechos ocurridos en la ciudad tales como obras o accidentes y que afectan a la circulación de vehículos."@es ;
  dct:title "Thesaurus that lists the types of incidents; that is, events that occur in the city such as construction work or accidents and that affect the flow of vehicles."@en ;
  dct:created "2020-03-31" ;
  dct:modified "2026-05-18" ;
  dct:creator "Adolfo Antón Bravo (OEG - Universidad Politécnica de Madrid)" ;
  dct:contributor "Edna Ruckhaus (OEG - Universidad Politécnica de Madrid)" ;
  a skos:ConceptScheme .

edintincidenttype:planned-incident
  skos:prefLabel "Planned incident"@en, "Incidencia planificada"@es ;
  skos:definition "Incidencia o evento planificado en la ciudad que afecta a la circulación de vehículos."@es, "Incident or planned event in the city that affects the circulation of vehicles."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType ;
  skos:narrower edintincidenttype:traffic-interruption, edintincidenttype:road-occupation, edintincidenttype:event, edintincidenttype:road-work .

edintincidenttype:unplanned-incident
  skos:prefLabel "Unplanned incident"@en, "Incidencia no planificada"@es ;
  skos:definition "Incidencia o evento no planificado en la ciudad que afecta a la circulación de vehículos."@es, "Incident or unplanned event in the city that affects the circulation of vehicles."@en ;
  a skos:Concept ;
  skos:inScheme edintkos:IncidentType ;
  skos:narrower edintincidenttype:accident, edintincidenttype:alert, 
edintincidenttype:climate-impact, edintincidenttype:traffic-jam, edintincidenttype:pollution, edintincidenttype:urgent-road-work .