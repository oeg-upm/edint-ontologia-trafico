@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cc: <http://creativecommons.org/ns#> .
@prefix edintkos: <http://vocab.linkeddata.es/datosabiertos/kos/edint/> .
@prefix edinttrafequiptype: <http://vocab.linkeddata.es/datosabiertos/kos/edint/TrafficEquipmentType/> .

edintkos:TrafficEquipmentType
  dct:title "Tesauro que recoge los tipos de equipo de tráfico; es decir tanto los dispositivos que permiten controlar el tráfico como los dispositivos que permiten la realización del conteo de vehículos (intensidad del tráfico) junto con la obtención del grado de ocupación de la vía."@es ;
  dct:title "Thesaurus that includes the types of traffic equipment; that is, both the devices that allow traffic control and the devices that allow the counting of vehicles (traffic intensity) along with obtaining the degree of occupancy of the road."@en ;
  rdfs:comment "This concept scheme belongs to the set of controlled SKOS-based thesauri used by the ontologies from the EDINT data space."@en ;
    rdfs:comment "Este esquema de conceptos pertenece al conjunto de tesauros SKOS usados por las ontologías del espacio de datos EDINT."@es ;
  dct:creator "Adolfo Antón Bravo (OEG - Universidad Politécnica de Madrid)" ;
  dct:contributor "Edna Ruckhaus(OEG - Universidad Politécnica de Madrid)" ;
  a skos:ConceptScheme ;
  rdfs:label "Tipo de Equipo de Tráfico"@es ;
  rdfs:label "Traffic equipment type"@en ;
  dct:created "2020-03-31" ;
  dct:modified "2026-05-18" ;
  skos:hasTopConcept edinttrafequiptype:measurement-device, edinttrafequiptype:control-device .

edinttrafequiptype:measurement-device
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Dispositivo de medición"@es, "Measurement Device"@en ;
  skos:definition "Tipo de dispositivo de medición de tráfico. Estos dispositivos realizan mediciones."@es, "Type of traffic measurement device. These devices perform measurements."@en ;
  skos:narrower edinttrafequiptype:bluetooth-detector, edinttrafequiptype:artificial-vision-station, edinttrafequiptype:magnetic-loop, edinttrafequiptype:magnetometer, edinttrafequiptype:rubber-detector .

edinttrafequiptype:bluetooth-detector
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Detector de bluetooth"@es, "Bluetooth detector"@en ;
  skos:definition "Un dispositivo que detecta dispositivos bluetooth instalados en los coches."@es, "A device that detects bluetooth devices installed in cars."@en ;
  skos:broader edinttrafequiptype:measurement-device .

edinttrafequiptype:artificial-vision-station
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Estación de visión artificial"@es, "Artificial vision Station"@en ;
  skos:definition "Permite medir los parámetros característicos del tráfico utilizando técnicas de procesamiento digital de imágenes con un comportamiento similar al del ojo humano. Permite realizar la detección y seguimiento de todos los vehículos dentro de un área determinada aparte de tomar medidas localizadas en puntos concretos. Las variables que se pueden obtener son: Intensidad circulatoria; velocidad media; ocupación y composición del tráfico (vehículos ligeros y pesados)."@es, "Allows the measurement of traffic parameras using digital image processing techniques with a behavior similar to that of the human eye. It allows the detection and tracking of all vehicles within a given area apart from taking measurements located at specific points. The variables that can be obtained are: traffic intensity; average speed; occupation and traffic composition (light and heavy vehicles)."@en ;
  skos:broader edinttrafequiptype:measurement-device .

edinttrafequiptype:magnetic-loop
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Lazo magnético"@es, "Magnetic loop"@en ;
  skos:definition "Dispositivo que detecta los cambios que se producen en un campo electromagnético cuando circula un vehículo (masa metálica) sobre un punto determinado de la calzada. Registra el número total de vehículos que pasan y pueden clasificarlos por su longitud; número de ejes y masas."@es, "A device that detects changes in an electromagnetic field when a vehicle (metal mass) is moving over a certain point on the road. It records the total number of vehicles passing by and can be classified by length; number of axes and mass."@en ;
  skos:broader edinttrafequiptype:measurement-device .

edinttrafequiptype:magnetometer
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Magnetómetro"@es, "Magnetometer"@en ;
  skos:definition "Aparato que mide la inducción de un campo magnético en una dirección determinada."@es, "A device that measures the induction of a magnetic field in a given direction."@en ;
  skos:broader edinttrafequiptype:measurement-device .

edinttrafequiptype:rubber-detector
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Tubo neumático"@es, "Rubber detector"@en ;
  skos:definition "Detector de goma en forma de tubo cerrado que se coloca transversalmente a la calzada. En el otro extremo el tubo termina en una membrana metálica flexible. Cuando pasan sobre él las ruedas de los vehículos aumenta la presión del aire en su interior; moviendo la membrana metálica que cierra un contacto eléctrico. Este tipo de detector es muy útil en instalaciones provisionales o de corta duración."@es, "Rubber detector in the form of a closed tube which is placed transversely to the road. At the other end the tube ends in a flexible metal membrane. When the wheels of the vehicles pass over it the internal air pressure increases; moving the metal membrane and closing an electrical contact. This type of detector is very useful in temporary or short term installations."@en ;
  skos:broader edinttrafequiptype:measurement-device .

edinttrafequiptype:control-device
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Equipo de control"@es, "Control device"@en ;
  skos:definition "Dispositivos que permiten controlar el tráfico."@es, "Devices that allow traffic control."@en ;
  skos:narrower edinttrafequiptype:traffic-control-camera, edinttrafequiptype:access-control, edinttrafequiptype:illegal-parking, edinttrafequiptype:license-plate-reader, edinttrafequiptype:variable-message-board, edinttrafequiptype:radar, edinttrafequiptype:centralized-traffic-light-controller, edinttrafequiptype:non-centralized-traffic-light-controller .

edinttrafequiptype:traffic-control-camera
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Cámara de control de tráfico"@es, "Traffic control camera"@en ;
  skos:definition "Cámara fija de control de tráfico."@es, "Fixed traffic control camera."@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:access-control
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Control de acceso"@es, "Access control"@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:illegal-parking
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Estacionamiento indebido"@es, "Illegal parking"@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:license-plate-reader
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Lector de matrícula"@es, "License plate reader"@en ;
  skos:definition "Cámara de televisión que capta un fotograma de cada uno de los vehículos que circulan por el carril que está monitorizando al que se le aplica un OCR que permite identificar los caracteres que componen la matrícula."@es, "A television camera that captures a frame of each of the vehicles circulating in the lane it is monitoring to which an OCR is applied to identify the characters that make up the license plate."@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:variable-message-board
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Panel de mensaje variable"@es, "Variable message board"@en ;
  skos:definition "Panel de mensaje variable que se utiliza para informar al usuario de las características del tráfico en la vía. La información mostrada engloba incidencias fortuitas (accidentes; vehículos averiados; etc.); estado del tráfico (retenciones); tiempos de recorrido; colas en los accesos; obras; campañas de tráfico; etc."@es, "Variable message board used to inform on characteristics of the traffic on the road. The information shown includes random incidents (accidents; broken vehicles; etc.); traffic status (delays); travel times; queues at access points; road works; traffic campaigns; etc."@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:radar
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Radar"@es, "Radar"@en ;
  skos:definition "Equipo que controla la velocidad de los vehículos. A su vez estos podrían clasificarse de la siguiente manera: fijo; túnel; semáforo; inicio/fin tramo; etc."@es, "Equipment that controls vehicle speed. These in turn could be classified as follows: fixed; tunnel; traffic light; start/end of section; etc."@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:centralized-traffic-light-controller
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Regulador semafórico centralizado"@es, "Centralized traffic light controller"@en ;
  skos:broader edinttrafequiptype:control-device .

edinttrafequiptype:non-centralized-traffic-light-controller
  skos:inScheme edintkos:TrafficEquipmentType ;
  a skos:Concept ;
  skos:prefLabel "Regulador semafórico no centralizado"@es, "Non-centralized traffic light controllerr"@en ;
  skos:broader edinttrafequiptype:control-device .

