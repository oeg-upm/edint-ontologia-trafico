
# TRA08: ¿Cuáles son los valores de intensidad en tiempo real registrados las estaciones que se encuentran en una calle determinada?

PREFIX edinttraf:   <http://vocab.linkeddata.es/datosabiertos/def/transporte/edinttrafico#>
PREFIX escjr:  <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:    <http://www.w3.org/2001/XMLSchema#>

SELECT ?street ?name ?device ?value ?time
WHERE {
  ?street a escjr:Via ;
          rdfs:label ?name ;
          escjr:containsStreetSection ?section .

  FILTER(CONTAINS(LCASE(?name), "NOMBRE-CALLE"))

  ?device a edinttraf:TrafficMeasurementDevice ;
          edinttraf:monitors ?section .

  ?obs a sosa:Observation ;
       sosa:madeBySensor ?device ;
       sosa:observedProperty edinttraf:intensity ;
       sosa:hasSimpleResult ?value ;
       sosa:resultTime ?time .

  # filtrando por ventana temporal	   

  FILTER(?time >= NOW() - "PT5M"^^xsd:duration)
}
ORDER BY DESC(?time)


#Variante más realista para tiempo real --> última observación

PREFIX edintedinttraf:   <http://vocab.linkeddata.es/datosabiertos/def/transporte/edintedinttrafico#>
PREFIX escjr:  <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/callejero#>
PREFIX sosa:   <http://www.w3.org/ns/sosa/>

SELECT ?street ?device ?value ?time
WHERE {
  ?street escjr:containsStreetSection ?section .

  ?device a edintedinttraf:TrafficMeasurementDevice ;
          edintedinttraf:monitors ?section .

  ?observation a sosa:Observation ;
               sosa:madeBySensor ?device ;
               sosa:observedProperty edintedinttraf:intensity ;
               sosa:hasSimpleResult ?value ;
               sosa:resultTime ?time .

  # Selecciona solo la última observación por dispositivo
  FILTER NOT EXISTS {
    ?otherObs sosa:madeBySensor ?device ;
              sosa:observedProperty edintedinttraf:intensity ;
              sosa:resultTime ?time2 .
    FILTER(?time2 > ?time)
  }
}